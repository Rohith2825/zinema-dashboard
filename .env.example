# ── Required ────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://qdnexjevlnpcydfbioug.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=https://dashboard.zinema.music

# ── Google Drive (pick ONE route; see /guide#drive) ─────────
# The "Zinema OS" folder everything is filed under (shared-drive id or folder id)
GOOGLE_DRIVE_ROOT_ID=
# Route A: service account (root must be inside a shared drive where it is Content manager)
GOOGLE_SERVICE_ACCOUNT_KEY=
# Route B: a Google account that owns the files
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# ── MCP personal tokens (optional) ──────────────────────────
# Supabase → Project Settings → JWT Keys → Legacy JWT secret. Server-only. Sign-in based MCP works without it.
SUPABASE_JWT_SECRET=
